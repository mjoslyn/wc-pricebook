{
    "name": "mjoslyn/wc-pricebook",
    "description": "Role/tier-based pricing engine for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/mjoslyn/wc-pricebook",
    "require": {
        "php": ">=7.4",
        "mpdf/mpdf": "^8.2"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "WCPricebook\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --runtime-set ignore_warnings_on_exit 1",
        "lint:fix": "phpcbf",
        "check": [
            "@lint",
            "@test"
        ]
    }
}
